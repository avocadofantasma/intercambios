{
  "name": "intercambio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --env-file=.env.local --watch server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/server.js",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
